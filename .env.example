# The URL this build will be served from. Everything origin- or path-dependent
# is derived from it: Vite's base path, the PWA manifest, the OAuth client id in
# the generated client-metadata.json, and the CNAME file.
#
# Leave it unset for local development — `npm run dev` uses AT Protocol's
# loopback client on http://127.0.0.1:5173.
#
# On GitHub Pages you do not need this at all: the deploy workflow asks GitHub
# where the site is published and passes the answer in. Set it only when
# deploying somewhere else (Netlify, Cloudflare Pages, your own server).
#
#   Custom domain          VITE_SITE_URL=https://my.wiki/
#   GitHub Pages subpath   VITE_SITE_URL=https://my-user.github.io/my-repo/
#
# VITE_SITE_URL=https://my.wiki/

# Name shown on your PDS's consent screen when signing in.
# Defaults to the site's hostname.
# SITE_NAME=My Wiki

# A CNAME file is written automatically for a custom domain (never for
# *.github.io). Set SITE_CNAME=0 to skip it, or to a hostname to override.
# SITE_CNAME=0

# Base URL of the donations companion API (see worker/README.md). Leave unset
# to ship without the Donate page. Never point this at Stripe directly — the
# worker serves the publishable key and Checkout Sessions for you.
# VITE_DONATIONS_API_URL=https://donate.my-wiki.workers.dev
