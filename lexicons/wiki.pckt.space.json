{
  "lexicon": 1,
  "id": "wiki.pckt.space",
  "defs": {
    "main": {
      "type": "record",
      "description": "Wiki-level configuration for a pckt.wiki space.",
      "key": "self",
      "record": {
        "type": "object",
        "required": ["title", "createdAt"],
        "properties": {
          "title": { "type": "string", "maxLength": 120 },
          "description": { "type": "string", "maxLength": 500 },
          "homeSlug": { "type": "string", "maxLength": 120 },
          "navOrder": {
            "type": "array",
            "items": { "type": "string" },
            "maxLength": 200
          },
          "theme": {
            "type": "ref",
            "ref": "#theme"
          },
          "createdAt": { "type": "string", "format": "datetime" },
          "updatedAt": { "type": "string", "format": "datetime" }
        }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "accentColor": { "type": "string", "maxLength": 32 },
        "fontFamily": { "type": "string", "maxLength": 64 },
        "mode": { "type": "string", "knownValues": ["light", "dark", "auto"] },
        "layoutWidth": { "type": "string", "knownValues": ["narrow", "medium", "wide"] }
      }
    }
  }
}
