{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pcktwiki-donations",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "donations",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  // Fixed-window per-IP guard on /api/config and /api/donations/checkout
  // (20 requests/minute) so checkout-session creation can't be spammed.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "vars": {
    // Comma-separated origins allowed to call /api/config and
    // /api/donations/checkout. Add your production URL and dev origin.
    "ALLOWED_ORIGINS": "https://pckt.wiki,http://127.0.0.1:5173",
    "CURRENCY": "usd",
    "SITE_NAME": "pckt.wiki"
  }
  // Secrets (never put these in vars): run
  //   npx wrangler secret put STRIPE_SECRET_KEY
  //   npx wrangler secret put STRIPE_PUBLISHABLE_KEY
  //   npx wrangler secret put STRIPE_WEBHOOK_SECRET
}
